# Copy to .env and fill in. See README.md for what each one does.

# One token, or several separated by commas (one per GitHub account)
GITHUB_TOKEN=

# Private repository that holds the shared state (create it empty, with a README)
STATE_REPO=owner/dashboard-state

# Journal: the repository Forward Flow syncs its entries to
FFLOW_REPO=owner/fflow

# Commit emails GitHub cannot tie to an account (comma separated)
GIT_AUTHOR_EMAILS=

# Optional: AI summaries and classifications (only the machine that generates them needs these)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Hosted copy only
# DASHBOARD_MODE=read
# DASHBOARD_PASSWORD=
